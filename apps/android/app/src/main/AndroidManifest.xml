<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The server is on another machine; the app is its window. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- allowBackup off: the address of a server on a private network has no
         business in somebody else's cloud backup, and the charts themselves
         live on the server, which has its own backups (Data & backup). -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kundali">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The "New chart" launcher shortcut (core/LaunchTarget). -->
            <intent-filter>
                <action android:name="io.github.chinmay28.kundali.NEW_CHART" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:theme="@style/Theme.Kundali.Settings">
            <intent-filter>
                <action android:name="io.github.chinmay28.kundali.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- "Save to Downloads" at the front of the share sheet. Exported
             because the share sheet launches it, but it copies only from the
             app's own FileProvider (see SaveToDownloadsActivity). -->
        <activity
            android:name=".SaveToDownloadsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/save_to_downloads"
            android:noHistory="true"
            android:theme="@style/Theme.Kundali.Invisible" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
